# Product uploads must be passive raster assets, not same-origin active content.
<FilesMatch "(?i)\.(svg|svgz|html|htm|xhtml|xml|js|mjs|swf)(\.|$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
