# Environment-specific secrets and server control files
/config.php
/admin/config.php
/.env
/.env.*
!/.env.example
/.user.ini
/php.ini
/admin/php.ini
/.ftpquota
/.well-known/

# Local/editor metadata
/.DS_Store
**/.DS_Store
/.idea/
/.vscode/

# Runtime state and generated code
/system/storage/cache/**
/system/storage/logs/**
/system/storage/session/**
/system/storage/upload/**
/system/storage/download/**
/system/storage/modification/**
/system/storage/marketplace/**
/vqmod/vqcache/**
/vqmod/logs/**
/vqmod/checked.cache
/vqmod/mods.cache
/image/cache/**

# Customer/product media stays on the server, except the execution guard
/image/catalog/**
!/image/catalog/.htaccess

# Incident evidence and operational state never belong in source control
/_incident/
/incident-*/
/*.tar
/*.tar.gz
/*.tgz
/*.sql.gz
/error_log
**/error_log
/index.html

# Disabled/backup copies and packaged OCMOD installers
*.bak
*.old
*.orig
*.save
*.swp
*.php_
*.xml-*
/oldhtaccess
/_ocmod/*.zip
