# Upload directory hardening. Keep this file even when OCMOD/VQMod caches refresh.
Options -ExecCGI

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
  RemoveHandler .php .php2 .php3 .php4 .php5 .php7 .php8 .php9 .phtml .pht .phtm .phar .phps .shtml .cgi .pl .py .sh
  RemoveType .php .php2 .php3 .php4 .php5 .php7 .php8 .php9 .phtml .pht .phtm .phar .phps .shtml .cgi .pl .py .sh
</IfModule>

<FilesMatch "(?i)\.(php[0-9]*|pht|phtm|phtml|phar|phps|shtml|cgi|pl|py|sh)(\.|$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(\.user\.ini|\.htaccess|\.htpasswd)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
