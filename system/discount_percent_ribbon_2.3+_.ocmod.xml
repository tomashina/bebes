	<!-- Precizan izračun s dvije decimale: round(...,2) -->

	<file path="catalog/controller/extension/module/bestseller.php">
		<operation>
			<search><![CDATA[$data['products'][] = array(]]></search>
			<add position="after"><![CDATA['percent' => ($result['price']>0 && $result['special']>0 && $result['special']<$result['price']) ? ('-' . round((($result['price'] - $result['special']) / $result['price']) * 100, 2) . ' %') : '',]]></add>
		</operation>
	</file>

