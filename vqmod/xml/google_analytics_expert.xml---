		<operation info="get list of stores for dropdown selection">
			<search position="after"><![CDATA[
			$this->load->model('setting/setting');
			]]></search>
			<add><![CDATA[
			$this->load->model('analytics/google_analytics');
			$data['stores'] = array();
						
			$stores = $this->model_analytics_google_analytics->getStores();
			
			foreach ($stores as $store) {
				$data['stores'][] = array(
					'store_id' => $store['store_id'],
					'store_name' => $store['store_name']
				);
			}
			]]></add>
		</operation>
		<operation error="skip">
			<search position="replace"><![CDATA[
			$this->model_setting_setting->editSetting('google_analytics', $this->request->post);
			]]></search>
